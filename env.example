# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=crunchy_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# App Configuration
NODE_ENV=development
PORT=3000
# Absolute origin used for media URLs in API responses (photos, avatars, ads).
# Leave empty to use the request's own protocol + host.
# e.g. PUBLIC_BASE_URL=https://api.crunchiiapp.com
PUBLIC_BASE_URL=
# Express "trust proxy" for client IPs (login rate limit). Default 'loopback'
# trusts X-Forwarded-For only from a proxy on this host (nginx). Use a hop
# count (e.g. 1) or a subnet list if the proxy runs elsewhere; 'false' = off.
TRUST_PROXY=loopback

# Google Places API (server only; the app never sees this key).
# The proxy uses the LEGACY Places web service (nearbysearch, textsearch,
# details, photo, autocomplete) plus the Geocoding API for /api/geocode/reverse;
# both must be enabled for this key. Restrict the key to this server's IP.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Verified social login (POST /api/socialLogin)
# Google OAuth client IDs whose ID tokens are accepted (comma-separated:
# iOS, Android and web client IDs).
GOOGLE_CLIENT_IDS=xxxx-ios.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com
# Expected audience of Apple identity tokens: the app's bundle ID (add a
# Services ID too, comma-separated, if web sign-in is ever used).
APPLE_BUNDLE_ID=com.crunchii.app
# Facebook app used to check access tokens via /debug_token.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# 'true' (default) still accepts the old unverified body (social_id without a
# token) for app builds released before Milestone 1. Set to 'false' once
# those builds are retired; the old body then gets 400.
ALLOW_LEGACY_SOCIAL_LOGIN=true

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration
# Comma-separated allowed origins. Unset or '*' allows every origin (the
# mobile app does not send an Origin header, so this only affects browsers).
CORS_ORIGINS=*

# Firebase Configuration (for Push Notifications)
# FIREBASE_SERVICE_ACCOUNT should be a JSON string of your Firebase service account credentials
# Example: FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project",...}'
# Or leave empty to use default credentials in Google Cloud environments
FIREBASE_SERVICE_ACCOUNT=
# Push outbox worker (every 2 s, claims push_outbox rows with SKIP LOCKED, so
# it is safe on several instances). 'false' turns it off on this instance.
PUSH_WORKER_ENABLED=true

# Tests only: throwaway Postgres for `npm run test:db` (never the DB above).
#   docker run -d --rm --name be-m1-pg -e POSTGRES_PASSWORD=test \
#     -e POSTGRES_DB=crunchy_test -p 55431:5432 postgres:16
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=55431
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=test
# TEST_DB_NAME=crunchy_test
