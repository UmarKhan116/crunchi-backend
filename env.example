# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=crunchy_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# App Configuration
NODE_ENV=development
PORT=3000

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Firebase Configuration (for Push Notifications)
# FIREBASE_SERVICE_ACCOUNT should be a JSON string of your Firebase service account credentials
# Example: FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project",...}'
# Or leave empty to use default credentials in Google Cloud environments
FIREBASE_SERVICE_ACCOUNT=
